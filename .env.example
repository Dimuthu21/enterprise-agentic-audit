GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

DB_MODE=demo
DEMO_DB_PATH=data/demo.sqlite

POLICY_MODE=demo
WEB_RISK_MODE=demo

CHECKPOINT_PATH=data/audit_state.sqlite

AUDIT_TIMEOUT_SECONDS=60
AUDIT_RETRIES=2
AUDIT_MAX_ITERATIONS=3
AUDIT_MAX_TOOL_CALLS=6

AUDIT_USERS_JSON={"local-reviewer":{"token":"PASTE_REVIEWER_TOKEN_HERE","role":"reviewer"},"local-submitter":{"token":"PASTE_SUBMITTER_TOKEN_HERE","role":"submitter"}}

# Local Windows SQL Server / ODBC Driver 17 example only. Keep encryption enabled
# for production SQL Server deployments with a valid server certificate.
# DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=YOUR_SERVER;DATABASE=AuditDB;Trusted_Connection=yes;TrustServerCertificate=yes;Encrypt=no;
